{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgen/spec/v1alpha2",
  "title": "SpecGen Canonical Specification v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "status",
    "state",
    "snapshot",
    "intent",
    "scope",
    "requirements",
    "acceptance_criteria",
    "evaluations",
    "implementation",
    "unresolved_questions",
    "traceability",
    "preservation",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "specgen/spec/v1alpha2"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "resolved",
        "validated",
        "compiled",
        "superseded"
      ]
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "objectives",
        "non_goals"
      ],
      "properties": {
        "problem": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "context": {
      "type": "object"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "data_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptance"
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evaluation"
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "phases"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedItem"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceLink"
      }
    },
    "preservation": {
      "$ref": "#/$defs/preservation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "current",
            "proposed"
          ]
        },
        "base_snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "change_id": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proposed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "base_snapshot_id",
              "change_id"
            ]
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "parent_snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "authoring_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the canonical snapshot serialization defined by the compiler. Optional until deterministic serialization is implemented."
        }
      }
    },
    "namedItem": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ],
          "default": "active"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ],
          "default": "active"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "functional",
            "nonfunctional",
            "constraint",
            "invariant"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "verification_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "criterion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ],
          "default": "active"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "type": "string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ],
          "default": "active"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "kind": {
          "type": "string"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "acceptance_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ],
          "default": "active"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "result_contract": {
          "type": "object"
        }
      }
    },
    "traceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "type": "string"
        }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preservationClaim"
          }
        }
      }
    },
    "preservationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_ref",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_ref": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "represented",
            "intentionally_excluded",
            "unresolved"
          ]
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenanceSource"
          }
        }
      }
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "user_input",
            "user_decision",
            "repository",
            "document",
            "web",
            "tool_output",
            "inference",
            "assumption"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authoring_event_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
