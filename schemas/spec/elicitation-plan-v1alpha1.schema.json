{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgen/elicitation-plan/v1alpha1",
  "title": "SpecGen Elicitation Plan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "ready", "blocker_count", "questions", "guardrails"],
  "properties": {
    "schema": {"const": "specgen/elicitation-plan/v1alpha1"},
    "mode": {"enum": ["express", "guided", "strict", "agent-workflow"]},
    "ready": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "prompt", "affected_paths", "affected_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["repair", "clarification", "evidence", "verification", "implementation", "compatibility"]},
          "severity": {"enum": ["question", "blocker"]},
          "prompt": {"type": "string", "minLength": 1},
          "affected_paths": {"type": "array", "items": {"type": "string"}},
          "affected_refs": {"type": "array", "items": {"type": "string"}},
          "guardrail": {"type": "string"}
        }
      }
    },
    "guardrails": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
