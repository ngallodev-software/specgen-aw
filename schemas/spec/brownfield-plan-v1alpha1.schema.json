{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgen/brownfield-plan/v1alpha1",
  "title": "SpecGen Brownfield Research Plan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "repository", "baseline", "mode", "strategy", "codebase_memory",
    "repository_analysis", "focus_areas", "user_questions", "research_tasks",
    "analysis_contract", "guardrails"
  ],
  "properties": {
    "schema": {"const": "specgen/brownfield-plan/v1alpha1"},
    "repository": {"$ref": "#/$defs/repository"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "mode": {"enum": ["express", "guided", "strict", "agent-workflow"]},
    "strategy": {"enum": ["evidence-first", "codebase-memory-assisted"]},
    "codebase_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "binary", "version", "mcp_registration", "cli_fallback"],
      "properties": {
        "available": {"type": "boolean"},
        "binary": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "mcp_registration": {"const": "unknown"},
        "cli_fallback": {"type": "boolean"}
      }
    },
    "repository_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "evidence_count", "interface_count", "data_contract_count", "contradiction_count", "blocker_count"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "evidence_count": {"type": "integer", "minimum": 0},
        "interface_count": {"type": "integer", "minimum": 0},
        "data_contract_count": {"type": "integer", "minimum": 0},
        "contradiction_count": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "affected_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^FOCUS-[0-9]{4}$"},
          "kind": {"enum": ["requirement", "interface", "data_contract", "scope", "contradiction"]},
          "label": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "affected_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "user_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "priority", "prompt", "rationale", "affected_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^BQ-[0-9]{4}$"},
          "kind": {"enum": ["intent", "scope", "preservation", "verification", "compatibility", "priority"]},
          "priority": {"enum": ["blocker", "important", "optional"]},
          "prompt": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "affected_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "research_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "preferred_tools", "stop_when"],
        "properties": {
          "id": {"type": "string", "pattern": "^RESEARCH-[0-9]{4}$"},
          "objective": {"type": "string", "minLength": 1},
          "preferred_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "stop_when": {"type": "string", "minLength": 1}
        }
      }
    },
    "analysis_contract": {"const": "specgen/brownfield-analysis/v1alpha1"},
    "guardrails": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "snapshot_id", "digest", "ready", "blocker_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "ready": {"type": "boolean"},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}, "name": {"type": "string"}}
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "dirty"],
      "properties": {
        "kind": {"enum": ["git", "directory"]},
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      }
    }
  }
}
