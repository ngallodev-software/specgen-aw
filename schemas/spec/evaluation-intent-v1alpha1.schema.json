{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgen/evaluation-intent/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec_id", "evaluations"],
  "properties": {
    "schema": {"const": "specgen/evaluation-intent/v1alpha1"},
    "spec_id": {"type": "string", "minLength": 1},
    "evaluations": {"type": "array", "items": {"$ref": "#/$defs/evaluation"}}
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "requirement_ids", "acceptance_ids", "oracle"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "oracle": {"enum": ["public", "hidden", "external"]},
        "scorer": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"}
      }
    }
  }
}
