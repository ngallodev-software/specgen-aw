{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgen/semantic-delta/v1alpha1",
  "title": "SpecGen Semantic Delta v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec_id", "from_snapshot_id", "to_snapshot_id", "changes"],
  "properties": {
    "schema": {"const": "specgen/semantic-delta/v1alpha1"},
    "spec_id": {"type": "string", "minLength": 1},
    "from_snapshot_id": {"type": "string", "minLength": 1},
    "to_snapshot_id": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["added", "modified", "removed"]},
        "path": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "before": {},
        "after": {}
      }
    }
  }
}
